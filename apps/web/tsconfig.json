{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@gest/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["src", "../../packages/core/src"],
  "exclude": ["../../packages/core/src/**/*.test.ts"]
}
